{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "$app/*": ["./app/*"],
      "$framework/*": ["./framework/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.svelte", "framework/**/*.ts", "vite.config.ts"]
}
